{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/r/:code", "destination": "/api/r/:code" },
    { "source": "/((?!api/|r/).*)", "destination": "/index.html" }
  ]
}
